<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
        <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
        <UsingMicrosoftNETSdkWorkloads>false</UsingMicrosoftNETSdkWorkloads>
        <SpaRoot>frontend\</SpaRoot>
        <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Atlassian.SDK" Version="13.0.0" />
      <PackageReference Include="Octokit" Version="14.0.0" />
      <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
      <PackageReference Include="Quartz.AspNetCore" Version="3.18.2" />
      <PackageReference Include="YamlDotNet" Version="17.1.0" />
      <PackageReference Include="Microsoft.Graph" Version="5.62.0" />
      <PackageReference Include="Azure.Identity" Version="1.13.1" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="wwwroot\assets\email.html" />
      <Content Update="frontend\**" CopyToOutputDirectory="Never" />
    </ItemGroup>

 


    <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" Inputs="$(SpaRoot)src\**;$(SpaRoot)package.json;$(SpaRoot)package-lock.json" Outputs="$(SpaRoot)package.json.build-stamp">
        <Message Importance="high" Text="--- Building Frontend (Configuration: $(Configuration)) ---" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
        <Touch Files="$(SpaRoot)package.json.build-stamp" AlwaysCreate="true" />
    </Target>

    <ItemGroup>
        <UpToDateCheckInput Include="$(SpaRoot)src\**" />
        <UpToDateCheckInput Include="$(SpaRoot)package.json" />
        <UpToDateCheckInput Include="$(SpaRoot)package-lock.json" />
    </ItemGroup>

    <ItemGroup>
        <FileWrites Include="$(SpaRoot)package.json.build-stamp" />
    </ItemGroup>

    <Target Name="PublishFrontend" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release'">
        <Message Importance="high" Text="--- Building Frontend (Release) ---" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    </Target>

    <ItemGroup>
        <None Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
